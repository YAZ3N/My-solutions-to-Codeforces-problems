#include <bits/stdc++.h>
using namespace std;
 void solve() {
     long long n;
     cin>>n;
    long long sum=0;
     for (long long i=1;i<=sqrt(n);i++) {
         if (n%i==0) {
             sum+=i;

             if (i!=n/i) {
                 sum+=n/i;
             }
         }
     }
     cout<<sum;
 }
int main() {

  solve();
}
