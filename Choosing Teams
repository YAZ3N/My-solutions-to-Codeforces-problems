#include <bits/stdc++.h>
using namespace std;
void Solve() {
    int n,k;
    cin>>n>>k;
    int x;
    vector<int>v;
    for (int i=0;i<n;i++) {
        cin>>x;
        v.push_back(x);
    }
    int f=0;
    for (int i=0;i<n;i++) {
        if (v[i]!=5 && 5-v[i]>=k) {
            f++;
        }
    }
    cout<<f/3;
}
int main() {
    Solve();
}
