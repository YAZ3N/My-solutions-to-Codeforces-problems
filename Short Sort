#include <bits/stdc++.h>
using namespace std;
void Solve() {
    int n;
    cin>>n;
    while (n--) {
        string s,orginal;
        cin>>s;
        orginal=s;
        if (s=="abc") {
            cout<<"yes"<<endl;
        }

        else {
            swap(s[0],s[1]);
            if (s=="abc") {
                cout<<"yes"<<endl;
            }
            else {
                s=orginal;
                swap(s[0],s[2]);
                if (s=="abc") {
                    cout<<"yes"<<endl;
                }
                else {
                    s=orginal;
                    swap(s[1],s[2]);
                    if (s=="abc") {
                        cout<<"yes"<<endl;
                    }
                    else {
                        cout<<"no"<<endl;
                    }
                }
            }
        }
    }
}
int main() {
    Solve();
}
