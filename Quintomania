#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int n;
    cin>>n;
    bool f=true;
    while (n--) {
        int size;
        cin>>size;
        int arr[size];
        f=true;
        for (int i=0;i<size;i++) {
            cin>>arr[i];
        }
        for (int i=0;i<size-1;i++) {
            if (abs(arr[i]-arr[i+1])!=5 && abs(arr[i]-arr[i+1])!=7) {
                f=false;
                break;
            }
        }
        if (f) {
            cout<<"yes"<<endl;
        }
        else {
            cout<<"no"<<endl;
        }
    }
}

int main() {
    Solve();
}
