#include <bits/stdc++.h>
using namespace std;
void solve() {
    int n;
    cin>>n;
    vector<int>v;
    while (n--) {
        int x;
        cin>>x;
        v.push_back(x);
    }
 int size=v.size();
    int result=0,p1=0,p2=0;
    result=abs(v[0]-v[size-1]);
    p1=1;
    p2=size;

    for (int i=0;i<size-1;i++) {
        if ((abs(v[i]-v[i+1]))<result) {
            result=abs(v[i]-v[i+1]);
            p1=i+1;
            p2=i+2;
        }
    }
    cout<<p1<<" "<<p2;
}
int main()
{
    solve();

}
