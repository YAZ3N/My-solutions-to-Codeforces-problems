#include <bits/stdc++.h>
using namespace std;
void Solve() {

    int n;
    cin>>n;
    int a,b,c;

    int counter=0,mx=0,mn=0;
    while (n--) {
        vector<int>v;
        cin>>a>>b>>c;
        v.push_back(a);
        v.push_back(b);
        v.push_back(c);

        counter=0,mx=0,mn=0;
        mx=*max_element(v.begin(),v.end());
        mn=*min_element(v.begin(),v.end());

        int x=0,y=0;
        for (int i=0;i<3;i++) {
            if (v[i]==mx) {
                x=i;
            }
            if (v[i]==mn) {
                y=i;
            }
        }

        while (v[0]!=v[1] && v[0]!=v[2] && v[1]!=v[2] ) {
            v[x]-=1;
            v[y]+=1;
            counter++;
        }
        cout<<counter<<endl;

    }

}
int main() {
    Solve();
}
