#include <bits/stdc++.h>
using namespace std;
 void solve() {
    int n;
     cin>>n;
 
     deque<int>q;
 
     for (int i=0;i<n;i++) {
         int x;
         cin>>x;
         q.push_back(x);
     }
 
     while (!q.empty()) {
         cout<<q.front()<<" ";
         q.pop_front();
         if (q.empty()) break;
         cout<<q.back()<<" ";
         q.pop_back();
     }
 }
int main() {
 
  solve();
}
