#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int n,m;
    cin>>n>>m;
    int arr[n][m];
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            cin>>arr[i][j];
        }
    }
    int x;
    cin>>x;
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            if (arr[i][j]==x) {
                cout<<"will not take number";
                return;
            }
        }
    }
    cout<<"will take number";
}

int main() {
    Solve();
}
