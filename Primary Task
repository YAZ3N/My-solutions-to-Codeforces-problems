#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int n;
    cin>>n;

    while (n--) {
        string s;
        cin>>s;

        if ( s.size()<3 ||s[0]!='1' || s[1]!='0') {
            cout<<"NO"<<endl;
            continue;
        }
        string s2=s.substr(2);

        if (s2[0]=='0') {
            cout<<"NO"<<endl;
        }
        else if (s2.size()==1 && s2[0]<'2') {
            cout<<"NO"<<endl;
        }
        else {
            cout<<"YES"<<endl;
        }
    }

}

int main() {
    Solve();

}
