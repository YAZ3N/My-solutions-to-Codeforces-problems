#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int n;
    cin>>n;
    queue<int>q;
    while (n--) {
        int a,b;
        cin>>a>>b;
        if (a==1) {
            q.push(b);
        }
        else {
            if (a==2 && q.empty()) {
                cout<<"no"<<endl;
            }
            else if (a==2 && !q.empty()) {
                if (q.front()==b) {
                    cout<<"yes"<<endl;
                }
                else {
                    cout<<"no"<<endl;
                }
            }
            q.pop();
        }

    }

}
int main() {
    Solve();
}
