#include <bits/stdc++.h>
using namespace std;
 
void solve() {
 
   int n;
    cin>>n;
    int countA=0,countD=0;
    string s;
    cin>>s;
    for (int i=0;i<s.size();i++) {
        if (s[i]=='A') {
            countA++;
        }
        else if (s[i]=='D') {
            countD++;
        }
    }
    if (countA>countD) {
        cout<<"Anton";
    }
    else if (countD>countA) {
        cout<<"Danik";
    }
    else {
        cout<<"Friendship";
    }
}
int main() {
 
    solve();
 
}
