#include <bits/stdc++.h>
using namespace std;

void Solve() {

 string s;
    cin>>s;
    vector<char>v;
    if (s.size()<2 && s.size()>0) {
        cout<<s;
        return;
    }
    for (int i=0;i<s.size();i++) {
        if (s[i]=='+') {
            continue;
        }
        else {
            v.push_back(s[i]);
        }
    }
    sort(v.begin(),v.end());
    for (int i=0;i<v.size();i++) {
        if (i%2!=0) {
            v.insert(v.begin()+i,'+');
        }
        cout<<v[i];
    }
}


int main() {
    Solve();

}
