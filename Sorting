#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin>>n;
    vector<int>v;
    while (n--) {
        int x;
        cin>>x;
        v.push_back(x);
    }
    sort(v.begin(),v.end());
    for (auto i=0;i<v.size();i++) {
        cout<<v[i]<<" ";
    }

}
int main() {
    solve();
    
}
