#include <bits/stdc++.h>
using namespace std;
 
void solve() {
 
  string name="Timur";
  int x;
  cin>>x;
 
  string s;
  cin>>s;
 
  sort(s.begin(),s.end());
  sort(name.begin(),name.end());
 
  if (s==name) {
    cout<<"yes"<<endl;
  }
  else {
    cout<<"no"<<endl;
  }
}
int main() {
  int n;
  cin>>n;
  while (n--) {
    solve();
  }
  
}
