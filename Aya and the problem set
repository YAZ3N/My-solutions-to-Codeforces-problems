#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int n;
    cin>>n;
    int a,b;
    int arr[n];

    for (int i=0;i<n;i++) {
        cin>>arr[i];
    }
    cin>>a>>b;
    int counter=0;
    for (int i=0;i<n;i++) {
        if (arr[i]>=a && arr[i]<=b) {
            counter++;
        }
    }
    if (counter==0) {
        cout<<0;
    }
    else {
        cout<<counter;
    }

}
int main() {

    Solve();

}
