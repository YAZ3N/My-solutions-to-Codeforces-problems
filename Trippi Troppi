#include <bits/stdc++.h>
using namespace std;

void Solve() {


      string s;
        getline(cin,s);

        cout<<s[0];
        for (int i=1;i<s.size();i++) {
            if (s[i-1] == ' ')
                cout<<s[i];
        }
        cout<<endl;
    }


int main() {
    int n;
    cin>>n;
    string s;
    getline(cin,s);
    while (n--){
        Solve();
    }
}
