#include <bits/stdc++.h>
using namespace std;

void Solve() {
    int n, k;
    cin >> n >> k;

    set<char> s;
    string s2 = "";

    for (int i = 0; i < k; i++) {
        s.insert('a' + i);
    }

    for (char c : s) {
        s2 += c;
    }

    for (int i = k; i < n; i++) {
        for (char o : s) {
            if (o != s2.back()) {
                s2 += o;
                break;
            }
        }
    }

    cout << s2;
}

int main() {
    Solve();
}
