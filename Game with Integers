#include <bits/stdc++.h>
using namespace std;
 void Solve() {

     int n;
     cin>>n;
     bool f=false;
     int counter=0;
     while (n--) {
          f=false;
         counter=0;
         int x;
         cin>>x;

         while (true) {
             if ((x+1)%3==0) {
                 f=true;
                 x+=1;
             }
             else  if ((x-1)%3==0) {
                 f=true;
                 x-=1;
             }
             else {
                 counter++;
             }
             if (counter==10) {
                 break;
             }
         }
         if (f) {
             cout<<"First"<<endl;
         }
         else {
             cout<<"Second"<<endl;
         }
     }
 }

int main() {
  Solve();
}
