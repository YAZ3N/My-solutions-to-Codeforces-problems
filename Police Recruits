#include <bits/stdc++.h>
using namespace std;
void Solve() {
   int n;
    cin>>n;
    vector<int>v;
    for (int i=0;i<n;i++) {
        int x;
        cin>>x;
        v.push_back(x);
    }
    int counter=0;
    int Officers=0;

    for (int i=0;i<n;i++) {
        if (v[i]==-1) {
            if (Officers>0) {
                Officers--;
            }
            else {
                counter++;
            }
        }
        else {
            Officers+=v[i];
        }
    }
    cout<<counter;
}
int main() {
    Solve();
}
