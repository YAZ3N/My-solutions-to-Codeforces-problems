#include <bits/stdc++.h>
using namespace std;
 
 void solve() {
  int n;
     cin>>n;
     int x,y;
 
     int counter1=0,counter2=0,counter3=0;
     while (n--) {
         cin>>x>>y;
 
         if (x>y) {
             counter1++;
         }
         else if (x<y) {
             counter2++;
         }
         else {
             counter3++;
         }
     }
     if (counter1>counter2) {
         cout<<"Mishka";
     }
     else if (counter2>counter1) {
         cout<<"Chris";
     }
     else {
         cout<<"Friendship is magic!^^";
     }
 }
int main() {
     
     solve();
 
}
