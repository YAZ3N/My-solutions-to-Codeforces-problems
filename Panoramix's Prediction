#include <bits/stdc++.h>
using namespace std;
bool isPrime(int m) {
    int counter=0;
    for (int i=1;i<=m;i++) {
        if (m%i==0) {
            counter++;
        }
    }
    return counter==2;
}
bool isNext(int n, int m) {
    for (int i=n+1;i<m;i++) {
        if (isPrime(i)) {
            return false;
        }
    }
    return isPrime(m);
}
void solve() {
    int n,m;
    cin>>n>>m;
    if (isNext(n,m)) {
        cout<<"YES";
    }
    else {
        cout<<"NO";
    }
}
int main() {
 
solve();
 
}
