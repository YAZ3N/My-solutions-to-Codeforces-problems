#include <bits/stdc++.h>
using namespace std;

void Solve() {

    int x,y;
    cin>>x>>y;

    for (int i=0;i<x;i++) {
        if (i%2==0) {
            for (int j=0;j<y;j++) {
                cout<<"#";
            }
        }
        else {
            if (i%4==1) {
                for (int j=0;j<y-1;j++) {
                    cout<<".";
                }
                cout<<"#";
            }
            else {
                cout<<"#";
                for (int j=0;j<y-1;j++) {
                   cout<<".";
                }
            }
        }
        cout<<endl;
        }
    }

int main() {
    Solve();
}
