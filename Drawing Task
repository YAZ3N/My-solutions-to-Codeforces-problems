#include <bits/stdc++.h>
using namespace std;
void Solve() {
    int n,m;
    cin>>n>>m;
    char arr[n+1][m+1];
    for (int i=1;i<n+1;i++) {
        for (int j=1;j<m+1;j++) {
            arr[i][j]='.';
        }
    }

    int s;
    cin>>s;

    while (s--) {
        int r1,c1,r2,c2;
        char c;
        cin>>r1>>c1>>r2>>c2;
        cin>>c;

        for (int i=min(r1,r2);i<=max(r1,r2);i++) {
            for (int j=min(c1,c2);j<=max(c1,c2);j++) {
                arr[i][j]=c;
            }
        }
    }
    for (int i=1;i<n+1;i++) {
        for (int j=1;j<m+1;j++) {
            cout<<arr[i][j];
        }
        cout<<endl;
    }

}
int main() {

    Solve();
}
