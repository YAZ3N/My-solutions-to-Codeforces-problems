#include <bits/stdc++.h>
using namespace std;

void Solve() {

   string s;
    cin>>s;
    for (int i=0;i<s.size();i++) {
      s[i]=tolower(s[i]);
    }
    int c1=0,c2=0,c3=0,c4=0,c5=0;
    for (int i=0;i<s.size();i++) {
    if (s[i]=='e') {
        c1++;
    }
        else if (s[i]=='g') {
            c2++;
        }
        else if (s[i]=='y') {
            c3++;
        }
        else if (s[i]=='p') {
            c4++;
        }
        else if (s[i]=='t') {
            c5++;
        }
    }
    cout<<min({c1,c2,c3,c4,c5});
}
int main() {
    Solve();
}
