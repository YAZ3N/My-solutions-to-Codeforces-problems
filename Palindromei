#include <bits/stdc++.h>
using namespace std;

void Solve() {
string s;
    cin>>s;
    int i=0;
    int j=s.size()-1;
 bool f=false;
    while (i<j) {
        if (s[i]!=s[j]) {
            f=true;
          break;
        }
          else {
          i++;
           j--;
          }

        }
    if (f) {
        cout<<"NO"<<endl;
    }
    else {
         cout<<"YES"<<endl;
    }

    }

int main() {
    Solve();
}
