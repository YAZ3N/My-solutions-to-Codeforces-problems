#include <bits/stdc++.h>
using namespace std;
void Solve() {
    int n;
    cin>>n;
    while (n--) {
        int size;
        cin>>size;
        int arr[size];
        for (int i=0;i<size;i++) {
            cin>>arr[i];
        }
        int counto=0,counte=0,op=0;

        for (int i=0;i<size;i++) {
         if (arr[i]%2==0) {
             counte++;
         }
            else {
                counto++;
            }
        }
        if (size%2!=0) {
            op=-1;
        }
        else {
           if (counte-counto==0) {
               op=0;
           }
            else {

                op=abs((counte-counto))/2;
            }
        }
       cout<<op<<endl;
    }

}

int main() {

    Solve();
}
