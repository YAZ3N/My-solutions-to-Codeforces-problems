#include <bits/stdc++.h>
using namespace std;

void Solve() {
    int n;
    cin>>n;
    bool f=true;
    while (n--) {
        string s;
        cin>>s;
        f=true;
       for (int i=0;i<s.size();i++) {
           if ((s[i]=='1' && s[i+1]=='0' && s[i+2]=='1') || (s[i]=='0' && s[i+1]=='1' && s[i+2]=='0')) {
               f=false;
           }
       }
        if (f==false) {
            cout<<"Good"<<endl;
        }
        else {
            cout<<"Bad"<<endl;
        }
    }
    }

int main() {
    Solve();
}
