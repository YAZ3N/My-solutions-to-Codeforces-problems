#include <bits/stdc++.h>
using namespace std;
 void Solve() {
 
     long long n;
     cin>>n;
     long long arr[n];
        for (int i=0;i<n;i++) {
          cin>>arr[i];
        }
     int maxi=0,mini=0;
     int mi=arr[0],ma=arr[0];
 
     for (int i=0;i<n;i++) {
         if (arr[i]>ma) {
             ma=arr[i];
             maxi=i;
         }
         if (arr[i]<mi) {
             mi=arr[i];
             mini=i;
         }
     }
     for (int i=0;i<n;i++) {
         if (i==mini) {
             arr[i]=ma;
         }
         if (i==maxi) {
             arr[i]=mi;
         }
     }
     for (int i=0;i<n;i++) {
         cout<<arr[i]<<" ";
     }
     }
 
int main() {
  Solve();
}
