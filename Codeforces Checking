#include<bits/stdc++.h>
using namespace std;

void solve(){
    
    int n;
    cin>>n;
    string s="codeforces";
    while(n--){
        bool f=false;
        char c;
        cin>>c;
        
        for(int i=0;i<s.size();i++){
          if(s[i]==c){
            f=true;
          }
        }
        if(f==true){
            cout<<"yes"<<endl;
        }
        else{
            cout<<"no"<<endl;
        }
      
    }
}
int main(){

solve();
}
